#!/bin/bash

# Script to backup frozen-hero database to a network share.
# The backup file is overwritten on each run.

# Adjust these variables to match your environment
SHARE_PATH=//hero-nas.hero.home/Backup
MOUNT_PATH=/mnt/HeRoQnap/Backup
PROJECT_ROOT=/home/hero/frozen-hero
CREDENTIALS_FILE=/home/hero/.nas-credentials

DB_SRC=$PROJECT_ROOT/database/frozen-hero.db
DB_DST=$MOUNT_PATH/frozen-hero/frozen-hero.db

if ! mountpoint -q $MOUNT_PATH; then
    if ! mount.cifs $SHARE_PATH $MOUNT_PATH \
        -o uid=1000,gid=1000,file_mode=0640,dir_mode=0750,credentials=$CREDENTIALS_FILE; then
        echo "Failed to mount NAS"
        exit 1
    fi
fi

if ! cp $DB_SRC $DB_DST; then
    echo "Failed to backup database"
    exit 1
fi

echo "Backup successful"
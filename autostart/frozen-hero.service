[Unit]
Description=frozen-hero Freezer Management System
After=network.target

[Service]
Type=simple
User=hero
WorkingDirectory=/home/hero/frozen-hero
Environment="PATH=/home/hero/frozen-hero/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/hero/frozen-hero/venv/bin/python -m frozen_hero
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target